---
interface Props {
	src: string;
	title?: string;
}

const { src, title = '企画書' } = Astro.props;
const fileName = src.split('/').pop() ?? 'document.pdf';
---

<section class="space-y-4" aria-labelledby="pdf-heading">
	<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
		<h2 id="pdf-heading" class="text-lg font-semibold text-[var(--color-text)] sm:text-xl">
			{title}
		</h2>
		<a
			href={src}
			download={fileName}
			target="_blank"
			rel="noopener noreferrer"
			class="btn-secondary w-full justify-center gap-2 px-4 py-2 text-sm sm:w-auto"
		>
			<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
				></path>
			</svg>
			PDFをダウンロード
		</a>
	</div>
	<div class="card overflow-hidden">
		<iframe
			src={src}
			title={title}
			class="h-[min(55vh,400px)] w-full sm:h-[min(70vh,600px)]"
			loading="lazy"
		></iframe>
	</div>
	<p class="text-xs text-[var(--color-muted)]">
		表示されない場合は
		<a href={src} class="text-[var(--color-accent)] hover:underline" target="_blank" rel="noopener noreferrer">
			新しいタブで開く
		</a>
		してください。
	</p>
</section>
