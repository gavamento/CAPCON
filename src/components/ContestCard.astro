---
import type { CollectionEntry } from 'astro:content';
import type { WorkTagId } from '../lib/tags';
import WorkTagBadges from './WorkTagBadges.astro';

interface Props {
	contest: CollectionEntry<'contests'>;
}

const { contest } = Astro.props;
const { title, summary, date, tags, award, organizer, thumbnail, driveLink } = contest.data;
const href = `/contests/${contest.id}`;
const thumb = thumbnail ?? '/images/placeholder-year1.svg';
const yearTags = (tags ?? []) as WorkTagId[];
---

<article class="card group flex h-full flex-col overflow-hidden">
	<a href={href} class="block overflow-hidden border-b border-[var(--color-border)]">
		<img
			src={thumb}
			alt=""
			class="aspect-video w-full object-cover"
			loading="lazy"
		/>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex flex-wrap items-center gap-2">
			<span class="tag tag--neutral">{date}</span>
			{yearTags.length > 0 && <WorkTagBadges tags={yearTags} />}
			{
				award && (
					<span class="tag border-[var(--color-accent)]/40 bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] text-[var(--color-accent)]">
						{award}
					</span>
				)
			}
		</div>
		<h3 class="text-lg font-semibold leading-snug text-[var(--color-text)]">
			<a href={href} class="card-link transition-colors">{title}</a>
		</h3>
		<p class="flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{summary}</p>
		{organizer && <p class="font-mono text-xs text-[var(--color-muted)]">{organizer}</p>}
		{
			driveLink && (
				<a
					href={driveLink}
					class="inline-flex items-center gap-1 font-mono text-xs text-[var(--color-accent)] transition hover:underline"
					target="_blank"
					rel="noopener noreferrer"
				>
					Googleドライブを開く →
				</a>
			)
		}
	</div>
</article>
