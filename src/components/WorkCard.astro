---
import type { CollectionEntry } from 'astro:content';
import { getEffectiveWorkTags, getWorkThumbnail, getWorkHighlightLead } from '../lib/works';
import WorkTagBadges from './WorkTagBadges.astro';

interface Props {
	work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, summary, role, driveLink, repoUrl } = work.data;
const displayTags = getEffectiveWorkTags(work.data);
const href = `/works/${work.id}`;
const thumb = getWorkThumbnail(work.data);
const lead = getWorkHighlightLead(work.data);
---

<article class="card group flex h-full flex-col overflow-hidden" data-reveal>
	<a href={href} class="block overflow-hidden border-b border-[var(--color-border)]">
		<img
			src={thumb}
			alt=""
			class="aspect-video w-full object-cover"
			loading="lazy"
		/>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex flex-wrap items-center gap-2">
			<WorkTagBadges tags={displayTags} />
		</div>
		<h3 class="text-lg font-semibold leading-snug text-[var(--color-text)]">
			<a href={href} class="card-link transition-colors">{title}</a>
		</h3>
		<p class="flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{summary}</p>
		{
			lead && (
				<p class="border-l-2 border-[var(--color-gold)] pl-2.5 text-xs leading-relaxed text-[var(--color-text)]">
					{lead}
				</p>
			)
		}
		<p class="font-mono text-xs text-[var(--color-muted)]">{role}</p>
		{
			repoUrl && (
				<a
					href={repoUrl}
					class="inline-flex items-center gap-1 font-mono text-xs text-[var(--color-accent)] transition hover:underline"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub →
				</a>
			)
		}
		{
			driveLink && (
				<a
					href={driveLink}
					class="inline-flex items-center gap-1 font-mono text-xs text-[var(--color-accent)] transition hover:underline"
					target="_blank"
					rel="noopener noreferrer"
				>
					Googleドライブ →
				</a>
			)
		}
	</div>
</article>
