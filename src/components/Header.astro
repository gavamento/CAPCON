---
const navItems = [
	{ href: '/', label: 'ホーム' },
	{ href: '/works', label: '作品一覧' },
	{ href: '/engineering', label: 'エンジニアリング' },
	{ href: '/about', label: 'プロフィール' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href="/" class="font-mono text-sm font-medium tracking-tight text-[var(--color-text)]">
			<span class="text-[var(--color-accent)]">/</span>portfolio
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
		<!-- デスクトップナビ -->
		<nav
			class="hidden items-center gap-1 md:flex"
			aria-label="メインナビゲーション"
		>
			{
				navItems.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === '/'
							: currentPath.startsWith(item.href);
					return (
						<a
							href={item.href}
							class:list={[
								'px-3 py-2 text-sm transition-colors',
								isActive
									? 'font-medium text-[var(--color-text)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4'
									: 'link-underline text-[var(--color-muted)] hover:text-[var(--color-text)]',
							]}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<!-- テーマ切り替えボタン（ライト / ダーク） -->
		<button
			type="button"
			class="theme-toggle flex h-11 w-11 items-center justify-center border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-muted)]"
			aria-label="テーマを切り替える"
			title="ライト / ダーク切り替え"
		>
			<!-- 現在ダーク → 月、現在ライト → 太陽 を表示 -->
			<svg class="theme-icon-dark h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
			</svg>
			<svg class="theme-icon-light hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4" stroke-width="2" />
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
			</svg>
		</button>

		<!-- モバイルメニューボタン -->
		<button
			type="button"
			class="mobile-nav-toggle flex h-11 w-11 items-center justify-center border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-muted)] md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="メニューを開く"
		>
			<svg class="mobile-nav-icon-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg class="mobile-nav-icon-close hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
		</div>
	</div>

	<!-- モバイルナビ（ドロワー） -->
	<nav
		id="mobile-nav"
		class="mobile-nav-panel hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] md:hidden"
		aria-label="メインナビゲーション（モバイル）"
	>
		<ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
			{
				navItems.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === '/'
							: currentPath.startsWith(item.href);
					return (
						<li>
							<a
								href={item.href}
								class:list={[
									'block border-b border-[var(--color-border)] py-3.5 text-base transition-colors last:border-b-0',
									isActive
										? 'font-medium text-[var(--color-accent)]'
										: 'text-[var(--color-muted)] hover:text-[var(--color-text)]',
								]}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>

<script>
	// テーマ切り替え＋モバイルドロワー。View Transitions でヘッダー DOM が差し替わっても
	// 動くよう、要素単位の多重バインド防止（data-bound）＋ astro:page-load 再バインドで実装。
	// グローバル（document/window）リスナーは一度だけ張り、発火時に現在の DOM を参照する。
	function resolvedTheme(): 'light' | 'dark' {
		const attr = document.documentElement.dataset.theme;
		if (attr === 'light' || attr === 'dark') return attr;
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function syncThemeIcon() {
		const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
		if (!btn) return;
		const isDark = resolvedTheme() === 'dark';
		btn.querySelector('.theme-icon-dark')?.classList.toggle('hidden', !isDark);
		btn.querySelector('.theme-icon-light')?.classList.toggle('hidden', isDark);
		btn.setAttribute('aria-label', isDark ? 'ライトモードに切り替える' : 'ダークモードに切り替える');
	}

	function setMobileNav(open: boolean) {
		const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
		const panel = document.querySelector<HTMLElement>('#mobile-nav');
		if (!toggle || !panel) return;
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
		panel.classList.toggle('hidden', !open);
		document.querySelector('.mobile-nav-icon-open')?.classList.toggle('hidden', open);
		document.querySelector('.mobile-nav-icon-close')?.classList.toggle('hidden', !open);
		document.body.classList.toggle('mobile-nav-open', open);
	}

	function bindHeader() {
		const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
		if (btn && btn.dataset.bound !== 'true') {
			btn.dataset.bound = 'true';
			btn.addEventListener('click', () => {
				const next = resolvedTheme() === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch (e) {}
				syncThemeIcon();
			});
		}

		const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
		if (toggle && toggle.dataset.bound !== 'true') {
			toggle.dataset.bound = 'true';
			toggle.addEventListener('click', () => {
				setMobileNav(toggle.getAttribute('aria-expanded') !== 'true');
			});
		}

		const panel = document.querySelector<HTMLElement>('#mobile-nav');
		if (panel && panel.dataset.bound !== 'true') {
			panel.dataset.bound = 'true';
			panel.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setMobileNav(false));
			});
		}

		syncThemeIcon();
		setMobileNav(false); // 遷移直後はドロワーを閉じておく
	}

	function bindHeaderGlobalsOnce() {
		if ((window as unknown as { __headerGlobals?: boolean }).__headerGlobals) return;
		(window as unknown as { __headerGlobals?: boolean }).__headerGlobals = true;

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			const t = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
			if (t?.getAttribute('aria-expanded') === 'true') setMobileNav(false);
		});

		// auto モード（明示選択なし）のときだけシステムのテーマ変更に追従
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
			if (!document.documentElement.dataset.theme) syncThemeIcon();
		});

		// デスクトップ幅に戻ったらドロワーを閉じる
		window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
			if (e.matches) setMobileNav(false);
		});
	}

	bindHeader();
	bindHeaderGlobalsOnce();
	document.addEventListener('astro:page-load', () => {
		bindHeader();
		bindHeaderGlobalsOnce();
	});
</script>
