---
const navItems = [
	{ href: '/', label: 'ホーム' },
	{ href: '/works', label: '作品一覧' },
	{ href: '/contests', label: '学内コンテスト' },
	{ href: '/about', label: 'プロフィール' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href="/" class="font-mono text-sm font-medium tracking-tight text-[var(--color-text)]">
			<span class="text-[var(--color-accent)]">/</span>portfolio
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
		<!-- デスクトップナビ -->
		<nav
			class="hidden items-center gap-1 md:flex"
			aria-label="メインナビゲーション"
		>
			{
				navItems.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === '/'
							: currentPath.startsWith(item.href);
					return (
						<a
							href={item.href}
							class:list={[
								'px-3 py-2 text-sm transition-colors',
								isActive
									? 'font-medium text-[var(--color-text)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4'
									: 'text-[var(--color-muted)] hover:text-[var(--color-text)]',
							]}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<!-- テーマ切り替えボタン（ライト / ダーク） -->
		<button
			type="button"
			class="theme-toggle flex h-11 w-11 items-center justify-center border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-muted)]"
			aria-label="テーマを切り替える"
			title="ライト / ダーク切り替え"
		>
			<!-- 現在ダーク → 月、現在ライト → 太陽 を表示 -->
			<svg class="theme-icon-dark h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
			</svg>
			<svg class="theme-icon-light hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4" stroke-width="2" />
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
			</svg>
		</button>

		<!-- モバイルメニューボタン -->
		<button
			type="button"
			class="mobile-nav-toggle flex h-11 w-11 items-center justify-center border border-[var(--color-border)] text-[var(--color-text)] transition hover:border-[var(--color-muted)] md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="メニューを開く"
		>
			<svg class="mobile-nav-icon-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg class="mobile-nav-icon-close hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
		</div>
	</div>

	<!-- モバイルナビ（ドロワー） -->
	<nav
		id="mobile-nav"
		class="mobile-nav-panel hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] md:hidden"
		aria-label="メインナビゲーション（モバイル）"
	>
		<ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
			{
				navItems.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === '/'
							: currentPath.startsWith(item.href);
					return (
						<li>
							<a
								href={item.href}
								class:list={[
									'block border-b border-[var(--color-border)] py-3.5 text-base transition-colors last:border-b-0',
									isActive
										? 'font-medium text-[var(--color-accent)]'
										: 'text-[var(--color-muted)] hover:text-[var(--color-text)]',
								]}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>

<script>
	// テーマ切り替え（ライト / ダーク）。明示選択は localStorage に保存し、
	// 未選択時はシステム設定（prefers-color-scheme）に追従する。
	(function initThemeToggle() {
		const root = document.documentElement;
		const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
		if (!btn) return;
		const iconDark = btn.querySelector('.theme-icon-dark');
		const iconLight = btn.querySelector('.theme-icon-light');
		const mql = window.matchMedia('(prefers-color-scheme: dark)');

		function resolved(): 'light' | 'dark' {
			const attr = root.dataset.theme;
			if (attr === 'light' || attr === 'dark') return attr;
			return mql.matches ? 'dark' : 'light';
		}

		function syncIcon() {
			const isDark = resolved() === 'dark';
			iconDark?.classList.toggle('hidden', !isDark);
			iconLight?.classList.toggle('hidden', isDark);
			btn.setAttribute('aria-label', isDark ? 'ライトモードに切り替える' : 'ダークモードに切り替える');
		}

		btn.addEventListener('click', () => {
			const next = resolved() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {}
			syncIcon();
		});

		// auto モード（明示選択なし）のときだけシステム変更に追従
		mql.addEventListener('change', () => {
			if (!root.dataset.theme) syncIcon();
		});

		syncIcon();
	})();

	const header = document.querySelector('.site-header');
	if (header) {
		const toggle = header.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
		const panel = header.querySelector<HTMLElement>('#mobile-nav');
		const iconOpen = header.querySelector('.mobile-nav-icon-open');
		const iconClose = header.querySelector('.mobile-nav-icon-close');

		function setOpen(open: boolean) {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
			panel.classList.toggle('hidden', !open);
			iconOpen?.classList.toggle('hidden', open);
			iconClose?.classList.toggle('hidden', !open);
			document.body.classList.toggle('mobile-nav-open', open);
		}

		toggle?.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
			}
		});

		window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
			if (e.matches) setOpen(false);
		});
	}
</script>
