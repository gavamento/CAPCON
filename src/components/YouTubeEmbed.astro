---
interface Props {
	videoId: string;
	title?: string;
}

const { videoId, title = '作品プレイ動画' } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
---

<div class="youtube-embed overflow-hidden border border-[var(--color-border)] bg-black" data-video-id={videoId}>
	<div class="relative aspect-video w-full">
		<button
			type="button"
			class="youtube-play group absolute inset-0 flex w-full cursor-pointer items-center justify-center bg-black/40 transition hover:bg-black/25"
			aria-label={`${title}を再生`}
		>
			<img
				src={thumbnailUrl}
				alt=""
				class="absolute inset-0 h-full w-full object-cover opacity-80"
				loading="lazy"
			/>
			<span
				class="relative z-10 flex h-14 w-14 items-center justify-center bg-red-600 text-white transition group-hover:bg-red-500"
			>
				<svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M8 5v14l11-7z" />
				</svg>
			</span>
		</button>
		<iframe
			class="youtube-iframe hidden h-full w-full"
			data-src={embedUrl}
			title={title}
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
			allowfullscreen
			loading="lazy"
		></iframe>
	</div>
</div>

<script>
	document.querySelectorAll('.youtube-embed').forEach((container) => {
		const button = container.querySelector('.youtube-play');
		const iframe = container.querySelector('.youtube-iframe') as HTMLIFrameElement | null;
		if (!button || !iframe) return;

		button.addEventListener('click', () => {
			const src = iframe.dataset.src;
			if (src) {
				iframe.src = src;
				iframe.classList.remove('hidden');
				button.remove();
			}
		});
	});
</script>
