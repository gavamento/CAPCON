---
import BaseLayout from '../layouts/BaseLayout.astro';
import GrowthTimeline from '../components/GrowthTimeline.astro';
import WorkCard from '../components/WorkCard.astro';
import { getAllWorks, getFeaturedWorks } from '../lib/works';

const works = await getAllWorks();
const featured = getFeaturedWorks(works);
---

<BaseLayout>
	<section class="border-b border-[var(--color-border)]">
		<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-24">
			<p class="section-eyebrow mb-4 sm:mb-6">Game Programmer / Planner</p>
			<h1 class="max-w-2xl text-[1.625rem] font-bold leading-[1.3] tracking-tight text-[var(--color-text)] sm:text-5xl">
				ゲームづくりへの<br class="hidden sm:block" />
				3年間の成長を、作品とともに。
			</h1>
			<p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-muted)]">
				HAL東京で培ったプログラミングと企画力を、動画・スクリーンショット・企画書でまとめた就活ポートフォリオです。
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:flex-wrap">
				<a href="/works" class="btn-primary w-full justify-center sm:w-auto">作品一覧を見る</a>
				<a href="/about" class="btn-secondary w-full justify-center sm:w-auto">プロフィール</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
		<GrowthTimeline works={works} showWorks={true} maxWorksPerYear={2} />
	</section>

	{
		featured.length > 0 && (
			<section class="border-t border-[var(--color-border)] py-14 sm:py-20">
				<div class="mx-auto max-w-6xl px-4 sm:px-6">
					<p class="section-eyebrow mb-2">Pick up</p>
					<h2 class="mb-8 text-2xl font-bold text-[var(--color-text)]">ピックアップ作品</h2>
					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{featured.map((work) => (
							<WorkCard work={work} />
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>
