---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillMatrix from '../components/SkillMatrix.astro';
import { skillCategories } from '../data/skills';
import { getAllWorks, getWorkTitleMap } from '../lib/works';

const works = await getAllWorks();
const workTitleById = getWorkTitleMap(works);

const email = 'akita.reon0811@gmail.com';

const links = [
	{ label: 'GitHubを見る', href: 'https://github.com/gavamento', icon: 'github' as const },
	{ label: email, href: `mailto:${email}`, icon: 'mail' as const },
];
---

<BaseLayout title="プロフィール" description="経歴・スキル・連絡先">
	<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="mb-14 border-b border-[var(--color-border)] pb-12">
			<img
				src="/images/profile.jpg"
				alt="秋田蓮音"
				width="112"
				height="112"
				class="mb-6 h-24 w-24 border border-[var(--color-border)] object-cover sm:h-28 sm:w-28"
			/>
			<p class="section-eyebrow mb-2">Profile</p>
			<h1 class="font-[var(--font-display)] text-2xl font-bold text-[var(--color-text)] sm:text-3xl">秋田蓮音</h1>
			<p class="mt-2 font-mono text-sm text-[var(--color-muted)]">
				HAL東京 ゲーム四年制学科ゲーム制作学部ゲーム制作専攻 — 2028年3月卒業予定
			</p>
			<p class="mt-5 max-w-lg text-sm leading-relaxed text-[var(--color-muted)]">
				ゲームプログラマー・ゲームプランナーを志望。3年間の学びを作品と企画書で証明します。
			</p>
		</header>

		<section class="mb-12 space-y-4">
			<h2 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-text)]">志望と強み</h2>
			<p class="leading-relaxed text-[var(--color-muted)]">
				プログラミングでは C++ を用いたゲームロジック実装とチーム開発でのテクニカルリード経験があります。
				企画面では 企画出し・企画書作成・仕様書作成からPM経験もあります。両面での経験を活かし、技術と企画の橋渡しができる人材を目指しています。
			</p>
			<h2 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-text)]">思い</h2>
			<p class="leading-relaxed text-[var(--color-muted)]">
				カプコンのエンジニアへのインタビュー記事で、「AIはクリエイターのポテンシャルを開放するために活用している」という言葉に出会いました。
				AIが台頭する今、私も同じ考えを持っています。AIはあくまでツールであり、それを使う人間の感性とクリエイティビティこそが本質だと。
				その信念を持つカプコンで、自分も作り手として成長したいと思っています。
			</p>
		</section>

		<section class="mb-12">
			<div class="mb-5 flex items-end justify-between gap-3">
				<h2 class="font-[var(--font-display)] text-lg font-semibold text-[var(--color-text)]">スキル</h2>
				<a href="/engineering" class="font-mono text-xs text-[var(--color-accent)] hover:underline">
					技術の詳細を見る →
				</a>
			</div>
			<SkillMatrix categories={skillCategories} workTitleById={workTitleById} compact />
		</section>

		<section class="mb-12">
			<h2 class="mb-5 font-[var(--font-display)] text-lg font-semibold text-[var(--color-text)]">経歴（概要）</h2>
			<ol class="space-y-5 border-l border-[var(--color-border)] pl-6">
				<li>
					<p class="font-mono text-xs text-[var(--color-accent)]">2024 — 1年次</p>
					<p class="mt-1 text-sm text-[var(--color-muted)]">C++基礎・2Dゲーム制作・企画演習</p>
				</li>
				<li>
					<p class="font-mono text-xs text-[var(--color-accent)]">2025 — 2年次</p>
					<p class="mt-1 text-sm text-[var(--color-muted)]">チーム制作・DirectXを用いた3Dゲーム開発・ステートマシン実装</p>
				</li>
				<li>
					<p class="font-mono text-xs text-[var(--color-accent)]">2026 — 3年次</p>
					<p class="mt-1 text-sm text-[var(--color-muted)]">チーム制作・就職作品作成</p>
				</li>
			</ol>
		</section>

		<section>
			<h2 class="mb-4 font-[var(--font-display)] text-lg font-semibold text-[var(--color-text)]">連絡先</h2>
			<ul class="flex flex-wrap gap-2">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.href.startsWith('mailto:') ? undefined : '_blank'}
								rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
								class="btn-secondary inline-flex items-center gap-2 border-[var(--color-accent)]/50 px-4 py-2 text-sm"
							>
								{link.icon === 'github' && (
									<svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill-rule="evenodd"
											d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
											clip-rule="evenodd"
										/>
									</svg>
								)}
								{link.icon === 'mail' && (
									<svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
										/>
									</svg>
								)}
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>
