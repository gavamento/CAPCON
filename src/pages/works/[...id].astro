---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import WorkTagBadges from '../../components/WorkTagBadges.astro';
import { getAllContests } from '../../lib/contests';
import { getEffectiveWorkTags } from '../../lib/works';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
	title,
	tags: _tags,
	contestIds,
	role,
	team,
	date,
	summary,
	youtubeId,
	images,
	pdf,
	tech,
	highlights,
	thumbnail,
	driveLink,
} = entry.data;

const galleryImages = images?.length ? images : thumbnail ? [thumbnail] : [];
const displayTags = getEffectiveWorkTags(entry.data);

const allContests = await getAllContests();
const relatedContests = allContests.filter((c) => contestIds?.includes(c.id));
---

<BaseLayout title={title} description={summary}>
	<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
		<a
			href="/works"
			class="mb-8 inline-flex items-center gap-1 font-mono text-sm text-[var(--color-muted)] transition hover:text-[var(--color-accent)]"
		>
			? ???????
		</a>

		<header class="mb-10 space-y-4">
			<div class="flex flex-wrap items-center gap-2">
				<WorkTagBadges tags={displayTags} size="md" />
			</div>
			{
				relatedContests.length > 0 && (
					<div class="flex flex-wrap items-center gap-2 text-sm">
						<span class="text-[var(--color-muted)]">???????:</span>
						{relatedContests.map((contest) => (
							<a
								href={`/contests/${contest.id}`}
								class="tag tag--contest px-3 py-1 transition hover:opacity-90"
							>
								{contest.data.title}
							</a>
						))}
					</div>
				)
			}
			<h1 class="text-3xl font-bold text-[var(--color-text)] sm:text-4xl">{title}</h1>
			<p class="text-lg text-[var(--color-muted)]">{summary}</p>
			<dl class="grid gap-2 text-sm sm:grid-cols-2">
				<div>
					<dt class="text-[var(--color-muted)]">??</dt>
					<dd class="font-medium text-[var(--color-text)]">{role}</dd>
				</div>
				<div>
					<dt class="text-[var(--color-muted)]">???</dt>
					<dd class="font-medium text-[var(--color-text)]">{team}</dd>
				</div>
				<div>
					<dt class="text-[var(--color-muted)]">????</dt>
					<dd class="font-medium text-[var(--color-text)]">{date}</dd>
				</div>
				{
					driveLink && (
						<div>
							<dt class="text-[var(--color-muted)]">??</dt>
							<dd>
								<a
									href={driveLink}
									class="font-medium text-[var(--color-accent)] transition hover:underline"
									target="_blank"
									rel="noopener noreferrer"
								>
									Google???????
								</a>
							</dd>
						</div>
					)
				}
			</dl>
		</header>

		{
			youtubeId && (
				<section class="mb-12">
					<h2 class="mb-4 text-xl font-semibold text-[var(--color-text)]">?????</h2>
					<YouTubeEmbed videoId={youtubeId} title={`${title} ?????`} />
				</section>
			)
		}

		{
			galleryImages.length > 0 && (
				<section class="mb-12">
					<h2 class="mb-4 text-xl font-semibold text-[var(--color-text)]">?????????</h2>
					<div class="grid gap-4 sm:grid-cols-2">
						{
							galleryImages.map((img) => (
								<img
									src={img}
									alt=""
									class="border border-[var(--color-border)] object-cover"
									loading="lazy"
								/>
							))
						}
					</div>
				</section>
			)
		}

		{
			pdf && (
				<section class="mb-12">
					<PdfViewer src={pdf} title={`${title} ? ???`} />
				</section>
			)
		}

		<section class="mb-12">
			<h2 class="mb-4 text-xl font-semibold text-[var(--color-text)]">????????</h2>
			<ul class="flex flex-wrap gap-2">
				{
					tech.map((t) => (
						<li class="tag tag--neutral px-3 py-1.5 text-sm">
							{t}
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-12">
			<h2 class="mb-4 text-xl font-semibold text-[var(--color-text)]">????????</h2>
			<ul class="space-y-2">
				{
					highlights.map((h) => (
						<li class="flex gap-3 text-[var(--color-muted)]">
							<span class="mt-2 font-mono text-[var(--color-accent)]" aria-hidden="true">?</span>
							<span>{h}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="prose-work card p-6 sm:p-8">
			<h2 class="mb-4 text-xl font-semibold text-[var(--color-text)]">??</h2>
			<Content />
		</section>
	</article>
</BaseLayout>
