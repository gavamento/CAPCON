---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import WorkTagBadges from '../../components/WorkTagBadges.astro';
import StatStrip from '../../components/StatStrip.astro';
import ContributionHeatmap from '../../components/ContributionHeatmap.astro';
import { getEffectiveWorkTags, getWorkGalleryImages } from '../../lib/works';
import { getContributionGraph } from '../../data/contributions';
import { publicAssetUrl } from '../../lib/assets';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
	title,
	tags: _tags,
	contest,
	award,
	role,
	team,
	date,
	summary,
	youtubeId,
	pdf,
	tech,
	highlights,
	devisedCases,
	contribution,
	driveLink,
	repoUrl,
	liveUrl,
	stats,
	statsImage,
} = entry.data;

const galleryImages = getWorkGalleryImages(entry.data);
const displayTags = getEffectiveWorkTags(entry.data);
const statsImageUrl = statsImage ? publicAssetUrl(statsImage) : null;
// 貢献グラフの実データがあれば CSS ヒートマップを優先（テーマ追従）。無ければ従来の画像。
const contributionGraph = getContributionGraph(entry.id);
---

<BaseLayout title={title} description={summary}>
	<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
		<a
			href="/works"
			class="mb-8 inline-flex items-center gap-1 font-mono text-sm text-[var(--color-muted)] transition hover:text-[var(--color-accent)]"
		>
			← 作品一覧に戻る
		</a>

		<header class="mb-10 space-y-4">
			<div class="flex flex-wrap items-center gap-2">
				<WorkTagBadges tags={displayTags} size="md" />
			</div>
			{
				contest && (
					<div class="flex flex-wrap items-center gap-2 text-sm">
						<span class="text-[var(--color-muted)]">出品コンテスト:</span>
						<span class="tag tag--contest px-3 py-1">{contest}</span>
						{award && (
							<>
								<span class="text-[var(--color-muted)]">結果:</span>
								<span class="font-medium text-[var(--color-text)]">{award}</span>
							</>
						)}
					</div>
				)
			}
			<h1 class="font-[var(--font-display)] text-3xl font-bold text-[var(--color-text)] sm:text-4xl">{title}</h1>
			<p class="text-lg text-[var(--color-muted)]">{summary}</p>
			<dl class="grid gap-2 text-sm sm:grid-cols-2">
				<div>
					<dt class="text-[var(--color-muted)]">担当</dt>
					<dd class="font-medium text-[var(--color-text)]">{role}</dd>
				</div>
				<div>
					<dt class="text-[var(--color-muted)]">チーム</dt>
					<dd class="font-medium text-[var(--color-text)]">{team}</dd>
				</div>
				<div>
					<dt class="text-[var(--color-muted)]">制作時期</dt>
					<dd class="font-medium text-[var(--color-text)]">{date}</dd>
				</div>
				{
					driveLink && (
						<div>
							<dt class="text-[var(--color-muted)]">資料</dt>
							<dd>
								<a
									href={driveLink}
									class="font-medium text-[var(--color-accent)] transition hover:underline"
									target="_blank"
									rel="noopener noreferrer"
								>
									Googleドライブを開く
								</a>
							</dd>
						</div>
					)
				}
				{
					repoUrl && (
						<div>
							<dt class="text-[var(--color-muted)]">リポジトリ</dt>
							<dd>
								<a
									href={repoUrl}
									class="font-medium text-[var(--color-accent)] transition hover:underline"
									target="_blank"
									rel="noopener noreferrer"
								>
									GitHub を開く
								</a>
							</dd>
						</div>
					)
				}
				{
					liveUrl && (
						<div>
							<dt class="text-[var(--color-muted)]">デモ</dt>
							<dd>
								<a
									href={liveUrl}
									class="font-medium text-[var(--color-accent)] transition hover:underline"
									target="_blank"
									rel="noopener noreferrer"
								>
									公開デモを開く
								</a>
							</dd>
						</div>
					)
				}
			</dl>
		</header>

		{
			contribution &&
				(contribution.summary || (contribution.items && contribution.items.length > 0)) && (
					<section class="mb-12" data-reveal>
						<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">
							個人の貢献
						</h2>
						<div class="card card--feature p-6 sm:p-8">
							{contribution.summary && (
								<p class="leading-relaxed text-[var(--color-muted)]">{contribution.summary}</p>
							)}
							{contribution.items && contribution.items.length > 0 && (
								<ul class="mt-4 space-y-2">
									{contribution.items.map((it) => (
										<li class="flex gap-3 text-[var(--color-text)]">
											<span class="mt-1.5 font-mono text-[var(--color-gold-dim)]" aria-hidden="true">
												▸
											</span>
											<span>{it}</span>
										</li>
									))}
								</ul>
							)}
						</div>
					</section>
				)
		}

		{
			youtubeId && (
				<section class="mb-12">
					<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">プレイ動画</h2>
					<YouTubeEmbed videoId={youtubeId} title={`${title} の動画`} />
				</section>
			)
		}

		{
			galleryImages.length > 0 && (
				<section class="mb-12">
					<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">スクリーンショット</h2>
					<div class="grid gap-4 sm:grid-cols-2">
						{
							galleryImages.map((img) => (
								<button
									type="button"
									class="lightbox-trigger group block cursor-zoom-in overflow-hidden border border-[var(--color-border)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
									data-src={img}
									aria-label="スクリーンショットを拡大表示"
								>
									<img
										src={img}
										alt=""
										class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
										loading="lazy"
									/>
								</button>
							))
						}
					</div>
				</section>
			)
		}

		{
			pdf && (
				<section class="mb-12">
					<PdfViewer src={pdf} title={`${title} 企画書`} />
				</section>
			)
		}

		{
			(stats?.length || statsImageUrl || contributionGraph || repoUrl || liveUrl) && (
				<section class="mb-12" data-reveal>
					<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">開発実績（GitHub）</h2>
					{stats && stats.length > 0 && <StatStrip stats={stats} class="mb-6" />}
					{contributionGraph ? (
						<ContributionHeatmap graph={contributionGraph} />
					) : (
						statsImageUrl && (
							<button
								type="button"
								class="lightbox-trigger group block w-full cursor-zoom-in overflow-hidden border border-[var(--color-border)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
								data-src={statsImageUrl}
								aria-label="貢献グラフを拡大表示"
							>
								<img
									src={statsImageUrl}
									alt="GitHub 貢献グラフ"
									class="w-full object-contain transition duration-300 group-hover:scale-[1.02]"
									loading="lazy"
								/>
							</button>
						)
					)}
					{(repoUrl || liveUrl) && (
						<div class="mt-4 flex flex-wrap gap-3">
							{repoUrl && (
								<a href={repoUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
									GitHub リポジトリ
								</a>
							)}
							{liveUrl && (
								<a href={liveUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
									デモを開く
								</a>
							)}
						</div>
					)}
				</section>
			)
		}

		<section class="mb-12">
			<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">使用技術</h2>
			<ul class="flex flex-wrap gap-2">
				{
					tech.map((t) => (
						<li class="tag tag--neutral px-3 py-1.5 text-sm">
							{t}
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-12" data-reveal>
			<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">工夫・学び</h2>
			{
				devisedCases && devisedCases.length > 0 ? (
					<div class="space-y-4">
						{devisedCases.map((c) => (
							<div class="card p-5 sm:p-6">
								<h3 class="font-[var(--font-display)] text-lg font-bold text-[var(--color-text)]">
									{c.title}
								</h3>
								<dl class="mt-3 space-y-3 text-sm">
									<div class="devised-row">
										<dt class="devised-label">課題</dt>
										<dd class="text-[var(--color-muted)]">{c.challenge}</dd>
									</div>
									<div class="devised-row">
										<dt class="devised-label">工夫</dt>
										<dd class="text-[var(--color-muted)]">{c.approach}</dd>
									</div>
									<div class="devised-row">
										<dt class="devised-label">成果</dt>
										<dd class="text-[var(--color-text)]">
											{c.result}
											{c.metric && <span class="devised-metric">{c.metric}</span>}
										</dd>
									</div>
								</dl>
							</div>
						))}
					</div>
				) : (
					<ul class="space-y-2">
						{highlights.map((h) => (
							<li class="flex gap-3 text-[var(--color-muted)]">
								<span class="mt-2 font-mono text-[var(--color-accent)]" aria-hidden="true">
									—
								</span>
								<span>{h}</span>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<section class="prose-work card p-6 sm:p-8">
			<h2 class="mb-4 font-[var(--font-display)] text-xl font-semibold text-[var(--color-text)]">詳細</h2>
			<Content />
		</section>
	</article>

	{
		(galleryImages.length > 0 || statsImageUrl) && (
			<div
				id="lightbox"
				class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
				role="dialog"
				aria-modal="true"
				aria-label="スクリーンショット拡大表示"
			>
				<button
					type="button"
					id="lightbox-close"
					class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
					aria-label="閉じる"
				>
					×
				</button>
				<img
					id="lightbox-image"
					src=""
					alt=""
					class="max-h-[90vh] max-w-[90vw] cursor-zoom-in object-contain transition-transform duration-200"
				/>
			</div>
		)
	}
</BaseLayout>

<script>
	// View Transitions 対応：要素単位の多重バインド防止＋ astro:page-load 再バインド。
	// Escape は開いている間だけ document に張る（ページをまたぐリスナー漏れを防ぐ）。
	function initLightbox() {
		const lightbox = document.getElementById('lightbox');
		const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
		const closeButton = document.getElementById('lightbox-close');
		const triggers = document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger');

		if (!lightbox || !lightboxImage) return;
		if (lightbox.dataset.bound === 'true') return;
		lightbox.dataset.bound = 'true';

		const ZOOM_SCALE = 2.5;
		let zoomed = false;

		const resetZoom = () => {
			zoomed = false;
			lightboxImage.style.transform = '';
			lightboxImage.style.cursor = 'zoom-in';
		};

		const open = (src: string) => {
			lightboxImage.src = src;
			resetZoom();
			lightbox.classList.remove('hidden');
			lightbox.classList.add('flex');
			document.body.style.overflow = 'hidden';
		};

		const close = () => {
			lightbox.classList.add('hidden');
			lightbox.classList.remove('flex');
			lightboxImage.src = '';
			resetZoom();
			document.body.style.overflow = '';
		};

		// クリック位置を中心にズームのオン/オフを切り替え
		const toggleZoom = (event: MouseEvent) => {
			if (zoomed) {
				resetZoom();
				return;
			}
			const rect = lightboxImage.getBoundingClientRect();
			const offsetX = ((event.clientX - rect.left) / rect.width - 0.5) * 100;
			const offsetY = ((event.clientY - rect.top) / rect.height - 0.5) * 100;
			zoomed = true;
			lightboxImage.style.transformOrigin = `${event.clientX - rect.left}px ${event.clientY - rect.top}px`;
			lightboxImage.style.transform = `scale(${ZOOM_SCALE}) translate(${-offsetX / ZOOM_SCALE}%, ${-offsetY / ZOOM_SCALE}%)`;
			lightboxImage.style.cursor = 'zoom-out';
		};

		// ズーム中はカーソル移動に合わせて画像をパン
		const panImage = (event: MouseEvent) => {
			if (!zoomed) return;
			const rect = lightboxImage.getBoundingClientRect();
			const percentX = (event.clientX - rect.left) / rect.width;
			const percentY = (event.clientY - rect.top) / rect.height;
			const moveX = (0.5 - percentX) * (ZOOM_SCALE - 1) * 100;
			const moveY = (0.5 - percentY) * (ZOOM_SCALE - 1) * 100;
			lightboxImage.style.transformOrigin = 'center center';
			lightboxImage.style.transform = `scale(${ZOOM_SCALE}) translate(${moveX / ZOOM_SCALE}%, ${moveY / ZOOM_SCALE}%)`;
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const src = trigger.dataset.src;
				if (src) open(src);
			});
		});

		closeButton?.addEventListener('click', close);

		lightboxImage.addEventListener('click', (event) => {
			event.stopPropagation();
			toggleZoom(event);
		});
		lightboxImage.addEventListener('mousemove', panImage);

		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) close();
		});
	}

	initLightbox();
	document.addEventListener('astro:page-load', initLightbox);

	// グローバルは一度だけ。Escape は現在表示中のライトボックスを閉じる（開閉ごとの
	// addEventListener をやめ、遷移をまたぐリスナー漏れを排除）。遷移時は overflow を必ず戻す。
	if (!(window as unknown as { __lightboxGlobals?: boolean }).__lightboxGlobals) {
		(window as unknown as { __lightboxGlobals?: boolean }).__lightboxGlobals = true;
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			const lb = document.getElementById('lightbox');
			if (lb && !lb.classList.contains('hidden')) {
				document.getElementById('lightbox-close')?.click();
			}
		});
		document.addEventListener('astro:before-swap', () => {
			document.body.style.overflow = '';
		});
	}
</script>
